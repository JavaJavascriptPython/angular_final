import { Component } from '@angular/core';

@Component({
  selector: 'app-root',
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.css']
})
export class AppComponent {
  // 👇 This data will be sent to the chart child component
  chartInfo = {
    title: 'Monthly Sales',
    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
    values: [120, 200, 150, 80, 70, 110]
  };

  // Example: change data dynamically (after 3 sec)
  ngOnInit() {
    setTimeout(() => {
      this.chartInfo = {
        title: 'Updated Sales',
        labels: ['Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
        values: [90, 160, 130, 190, 230, 170]
      };
    }, 3000);
  }
}






<app-chart *ngIf="chartInfo" [chartData]="chartInfo"></app-chart>


<!-- Parent passes chart data to child -->
<app-chart [chartData]="chartInfo"></app-chart>