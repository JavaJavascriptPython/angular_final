<div class="report-container">
  <form [formGroup]="dateForm" (ngSubmit)="fetchData()" class="date-form">

    <div class="form-field">
      <label for="start">Start Date</label>
      <input
        id="start"
        type="date"
        formControlName="startDate"
        (change)="validateDates()">
    </div>

    <div class="form-field">
      <label for="end">End Date</label>
      <input
        id="end"
        type="date"
        formControlName="endDate"
        (change)="validateDates()">
    </div>

    <button type="submit" [disabled]="!dateForm.valid || dateError">Get Data</button>
  </form>

  <p class="error" *ngIf="dateError">{{ dateError }}</p>

  <!-- child table -->
  <tps-table
    [headers]="tableHeaders"
    [col1]="col1Data"
    [col2]="col2Data">
  </tps-table>
</div>






import { Component, OnInit } from '@angular/core';
import { FormBuilder, FormGroup, Validators } from '@angular/forms';
import { HttpClient } from '@angular/common/http';
import { formatDate } from '@angular/common';

@Component({
  selector: 'app-report',
  templateUrl: './report.component.html',
  styleUrls: ['./report.component.css']
})
export class ReportComponent implements OnInit {
  dateForm!: FormGroup;
  dateError = '';
  tableHeaders: string[] = [];
  col1Data: any[] = [];
  col2Data: any[] = [];

  constructor(private fb: FormBuilder, private http: HttpClient) {}

  ngOnInit() {
    const end = new Date();
    const start = new Date();
    start.setDate(end.getDate() - 7);

    this.dateForm = this.fb.group({
      startDate: [formatDate(start, 'yyyy-MM-dd', 'en'), Validators.required],
      endDate: [formatDate(end, 'yyyy-MM-dd', 'en'), Validators.required]
    });

    this.validateDates();
    this.fetchData(); // auto load for last 7 days
  }

  validateDates() {
    const start = new Date(this.dateForm.value.startDate);
    const end = new Date(this.dateForm.value.endDate);

    if (start > end) {
      this.dateError = 'Start date cannot be later than end date.';
    } else {
      this.dateError = '';
    }
  }

  fetchData() {
    if (this.dateError) return;

    const start = this.dateForm.value.startDate;
    const end = this.dateForm.value.endDate;

    // Mock API call - replace with actual endpoint
    this.http.get<any>(`https://example.com/api/report?start=${start}&end=${end}`)
      .subscribe(res => {
        this.tableHeaders = res.headers;
        this.col1Data = res.col1;
        this.col2Data = res.col2;
      });
  }
}







.report-container {
  background: #fff;
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  max-width: 800px;
  margin: 1.5rem auto;
  font-family: 'Segoe UI', sans-serif;
}

.date-form {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 1rem;
  margin-bottom: 1rem;
}

.form-field {
  display: flex;
  flex-direction: column;
}

label {
  font-weight: 600;
  color: #0a3d62;
  margin-bottom: 0.2rem;
}

input[type="date"] {
  padding: 0.5rem;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 0.95rem;
  outline: none;
  transition: border-color 0.2s;
}

input[type="date"]:focus {
  border-color: #1976d2;
}

button {
  background-color: #1976d2;
  color: white;
  padding: 0.55rem 1.3rem;
  border: none;
  border-radius: 6px;
  font-size: 0.95rem;
  cursor: pointer;
  transition: background-color 0.2s;
}

button:hover:not(:disabled) {
  background-color: #125ea4;
}

button:disabled {
  background-color: #ccc;
  cursor: not-allowed;
}

.error {
  color: #d32f2f;
  font-weight: 500;
  font-size: 0.9rem;
  margin-top: -0.5rem;
  margin-bottom: 1rem;
}