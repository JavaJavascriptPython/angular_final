import { Component } from '@angular/core';

@Component({
  selector: 'app-root',
  template: `
    <app-line-chart
      [xLabels]="xLabels"
      [seriesData]="seriesData"
      [seriesNames]="seriesNames">
    </app-line-chart>
  `
})
export class AppComponent {
  // X-axis labels
  xLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  // Each inner array = Y values for one line
  seriesData = [
    [120, 132, 101, 134, 90, 230, 210],
    [220, 182, 191, 234, 290, 330, 310],
    [150, 232, 201, 154, 190, 330, 410],
    [320, 332, 301, 334, 390, 330, 320]
  ];

  // Names of each line for legend
  seriesNames = ['Line 1', 'Line 2', 'Line 3', 'Line 4'];
}







import { Component, Input, ElementRef, OnInit, OnDestroy } from '@angular/core';
import * as echarts from 'echarts';

@Component({
  selector: 'app-line-chart',
  template: `<div id="chartContainer" style="width:100%; height:400px;"></div>`,
})
export class LineChartComponent implements OnInit, OnDestroy {
  // Input data from parent
  @Input() xLabels: any[] = [];
  @Input() seriesData: number[][] = [];  // Array of arrays
  @Input() seriesNames: string[] = [];   // Legend names

  private chartInstance: any;

  constructor(private el: ElementRef) {}

  ngOnInit(): void {
    // 1️⃣ Get container div
    var container = this.el.nativeElement.querySelector('#chartContainer');

    // 2️⃣ Initialize ECharts
    this.chartInstance = echarts.init(container);

    // 3️⃣ Prepare dynamic series config
    var dynamicSeries: any[] = [];
    for (var i = 0; i < this.seriesData.length; i++) {
      dynamicSeries.push({
        name: this.seriesNames[i] || 'Series ' + (i + 1),
        type: 'line',
        smooth: true,
        data: this.seriesData[i],
      });
    }

    // 4️⃣ Define chart options
    var options = {
      tooltip: { trigger: 'axis' },
      legend: { data: this.seriesNames },
      grid: {
        left: '3%',
        right: '4%',
        bottom: '3%',
        containLabel: true,
      },
      xAxis: {
        type: 'category',
        data: this.xLabels,
      },
      yAxis: { type: 'value' },
      series: dynamicSeries, // ← dynamically generated
    };

    // 5️⃣ Set options
    this.chartInstance.setOption(options);

    // 6️⃣ Handle resizing
    var that = this;
    window.addEventListener('resize', function () {
      if (that.chartInstance) {
        that.chartInstance.resize();
      }
    });
  }

  ngOnDestroy(): void {
    // Dispose chart to prevent memory leaks
    if (this.chartInstance) {
      this.chartInstance.dispose();
    }
  }
}






import { NgModule } from '@angular/core';
import { BrowserModule } from '@angular/platform-browser';
import { AppComponent } from './app.component';
import { LineChartComponent } from './line-chart/line-chart.component';

@NgModule({
  declarations: [AppComponent, LineChartComponent],
  imports: [BrowserModule],
  bootstrap: [AppComponent],
})
export class AppModule {}