import { BrowserModule } from '@angular/platform-browser';
import { NgModule } from '@angular/core';
import { HttpClientModule } from '@angular/common/http';
import { BrowserAnimationsModule } from '@angular/platform-browser/animations';

import {
  MatTableModule,
  MatPaginatorModule,
  MatInputModule,
  MatFormFieldModule
} from '@angular/material';

import { AppComponent } from './app.component';

@NgModule({
  declarations: [AppComponent],
  imports: [
    BrowserModule,
    BrowserAnimationsModule,
    HttpClientModule,
    MatTableModule,
    MatPaginatorModule,
    MatInputModule,
    MatFormFieldModule
  ],
  bootstrap: [AppComponent]
})
export class AppModule {}




import {
  Component,
  OnInit,
  ViewChild,
  AfterViewInit,
  ChangeDetectionStrategy
} from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { MatTableDataSource, MatPaginator } from '@angular/material';

export interface TableRow {
  branch: string;
  cpu: number;
  memory: number;
  disk: number;
  io: number;
  network: number;
  timestamp: string;
  server: string;
  status: string;
}

@Component({
  selector: 'app-root',
  templateUrl: './app.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class AppComponent implements OnInit, AfterViewInit {

  displayedColumns: string[] = [
    'branch',
    'server',
    'cpu',
    'memory',
    'disk',
    'io',
    'network',
    'timestamp',
    'status'
  ];

  dataSource = new MatTableDataSource<TableRow>();

  @ViewChild(MatPaginator) paginator: MatPaginator;

  constructor(private http: HttpClient) {}

  ngOnInit() {
    this.fetchData();

    // Filter only on branch + server
    this.dataSource.filterPredicate = (data, filter) => {
      const search = filter.toLowerCase();
      return (
        data.branch.toLowerCase().includes(search) ||
        data.server.toLowerCase().includes(search)
      );
    };
  }

  ngAfterViewInit() {
    this.dataSource.paginator = this.paginator;
  }

  fetchData() {
    this.http.get<TableRow[]>('YOUR_API_URL_HERE')
      .subscribe(res => {
        this.dataSource.data = res;
      });
  }

  applyFilter(value: string) {
    this.dataSource.filter = value.trim().toLowerCase();
  }
}





<div class="page-wrapper">
  <div class="table-card">

    <div class="table-header">
      <div class="title">Branch Metrics</div>

      <mat-form-field appearance="outline" class="search-box">
        <mat-label>Search</mat-label>
        <input
          matInput
          (keyup)="applyFilter($event.target.value)"
          placeholder="Search Branch or Server">
      </mat-form-field>
    </div>

    <table mat-table [dataSource]="dataSource" class="mat-table-custom">

      <ng-container matColumnDef="branch">
        <th mat-header-cell *matHeaderCellDef> Branch </th>
        <td mat-cell *matCellDef="let r"> {{r.branch}} </td>
      </ng-container>

      <ng-container matColumnDef="server">
        <th mat-header-cell *matHeaderCellDef> Server </th>
        <td mat-cell *matCellDef="let r"> {{r.server}} </td>
      </ng-container>

      <ng-container matColumnDef="cpu">
        <th mat-header-cell *matHeaderCellDef> CPU % </th>
        <td mat-cell *matCellDef="let r"
            [ngClass]="{'high': r.cpu > 80}">
          {{r.cpu}}
        </td>
      </ng-container>

      <ng-container matColumnDef="memory">
        <th mat-header-cell *matHeaderCellDef> Memory % </th>
        <td mat-cell *matCellDef="let r"> {{r.memory}} </td>
      </ng-container>

      <ng-container matColumnDef="disk">
        <th mat-header-cell *matHeaderCellDef> Disk % </th>
        <td mat-cell *matCellDef="let r"> {{r.disk}} </td>
      </ng-container>

      <ng-container matColumnDef="io">
        <th mat-header-cell *matHeaderCellDef> IO </th>
        <td mat-cell *matCellDef="let r"> {{r.io}} </td>
      </ng-container>

      <ng-container matColumnDef="network">
        <th mat-header-cell *matHeaderCellDef> Network </th>
        <td mat-cell *matCellDef="let r"> {{r.network}} </td>
      </ng-container>

      <ng-container matColumnDef="timestamp">
        <th mat-header-cell *matHeaderCellDef> Time </th>
        <td mat-cell *matCellDef="let r"> {{r.timestamp}} </td>
      </ng-container>

      <ng-container matColumnDef="status">
        <th mat-header-cell *matHeaderCellDef> Status </th>
        <td mat-cell *matCellDef="let r"> {{r.status}} </td>
      </ng-container>

      <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
      <tr mat-row *matRowDef="let row; columns: displayedColumns;"></tr>

    </table>

    <mat-paginator
      [pageSize]="50"
      [pageSizeOptions]="[25, 50, 100]"
      showFirstLastButtons>
    </mat-paginator>

  </div>
</div>