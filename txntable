<table mat-table [dataSource]="Datasource" class="mat-elevation-z8">

  <!-- Dynamic Columns -->
  <ng-container
    *ngFor="let col of Columkeys; let i = index"
    [matColumnDef]="col">

    <!-- Header -->
    <th mat-header-cell *matHeaderCellDef>
      {{ DisplayHeaders[i] }}
    </th>

    <!-- Cell -->
    <td mat-cell *matCellDef="let row">
      {{ row[col] }}
    </td>

    <!-- Footer -->
    <td mat-footer-cell *matFooterCellDef>
      {{ Footertotal[i] || '' }}
    </td>

  </ng-container>

  <!-- Header Row -->
  <tr mat-header-row *matHeaderRowDef="Columkeys"></tr>

  <!-- Data Row -->
  <tr mat-row *matRowDef="let row; columns: Columkeys"></tr>

  <!-- Footer Row -->
  <tr mat-footer-row *matFooterRowDef="Columkeys"></tr>

</table>