<table mat-table [dataSource]="Datasource" class="mat-elevation-z8">

  <ng-container *ngFor="let col of Columkeys; let i = index" [matColumnDef]="col">

    <!-- Header -->
    <th mat-header-cell *matHeaderCellDef>
      {{ DisplayHeaders[i] }}
    </th>

    <!-- Cell -->
    <td mat-cell *matCellDef="let row">

      <!-- DATE -->
      <ng-container *ngIf="col === 'date'">
        {{ row.date | date:'dd-MMM-yyyy' }}
      </ng-container>

      <!-- DAY (derived, NOT from datasource) -->
      <ng-container *ngIf="col === 'day'">
        {{ row.date | date:'EEEE' }}
      </ng-container>

      <!-- OTHER COLUMNS -->
      <ng-container *ngIf="col !== 'date' && col !== 'day'">
        {{ row[col] }}
      </ng-container>

    </td>

    <!-- Footer -->
    <td mat-footer-cell *matFooterCellDef>
      {{ Footertotal[i] || '' }}
    </td>

  </ng-container>

  <tr mat-header-row *matHeaderRowDef="Columkeys"></tr>
  <tr mat-row *matRowDef="let row; columns: Columkeys"></tr>
  <tr mat-footer-row *matFooterRowDef="Columkeys"></tr>

</table>